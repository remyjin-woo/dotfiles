layout {
    gaps 16
    center-focused-column           "never"
    always-center-single-column
    background-color                "transparent"
    preset-column-widths {
        proportion                  0.33333
        proportion                  0.5
        proportion                  0.66667
    }
    focus-ring {
        off
        width                       2
        active-color                "#4F29A8"
    }
    shadow {
        on
        softness                    45
    }
    struts {

    }
}
