{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "logo": {
    "source": "~/.config/fastfetch/noctalia.png",
    "type": "auto",
    "height": 15,
    "padding": {
      "top": 2,
      "left": 2
    }
  },
  "modules": [
    "title",
    "separator",
    "os",
    "host",
    "kernel",
    "uptime",
    "packages",
    "shell",
    "terminal",
    "cpu",
    "gpu",
    "memory",
    "disk",
    "localip",
    "battery",
    "locale",
    "break",
  ],
  "display": {
    "separator": " ",     // Separator between keys and values
    "color": {
      "keys": "blue",     // Key color
      "title": "blue"     // Title color
    },
    "key": {
      "width": 12,        // Aligns keys to this width
      "type": "both"      // string, icon, both, or none
    },
    "bar": {
      "width": 10,        // Width of percentage bars
      "char": {
        "elapsed": "■",   // Character for elapsed portion
        "total": "-",     // Character for total portion
      },
    },
    "percent": {
      "type": 9,          // 1=number, 2=bar, 3=both, 9=colored number
      "color": {
        "green": "green",
        "yellow": "light_yellow",
        "red": "light_red"
      }
    }
  }
}
