{
  "logo": {
    "source": "~/.config/fastfetch/noctalia.png",
    "type": "auto",
    "height": 15,
    "padding": {
      "top": 2,
      "left": 2
    }
  },
  "modules": [
    "title",
    "separator",
    "os",
    "host",
    "kernel",
    "uptime",
    "packages",
    "shell",
    "terminal",
    "cpu",
    "gpu",
    "memory",
    "disk",
    "localip",
    "battery",
    "locale",
    "separator",
    "break"
  ],
  "display": {
    "separator": " ",
    "color": {
      "keys": "#59C2FF",
      "title": "#FAE3B0"
    },
    "key": {
      "width": 12,
      "type": "both"
    },
    "bar": {
      "width": 10,
      "char": {
        "elapsed": "■",
        "total": " "
      },
      "color": {
        "elapsed": "#91B362",
        "total": "#282C34"
      }
    },
    "percent": {
      "type": 9,
      "color": {
        "green": "#91B362",
        "yellow": "#FFD47E",
        "red": "#F28779"
      }
    }
  }
}
