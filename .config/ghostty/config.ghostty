font-family = "FiraCode Nerd Font"
font-size = 11
# kitty: modify_font cell_height 115%
adjust-cell-height = 15%
# same stylistic sets as kitty
font-feature = ss02
font-feature = ss03
font-feature = ss05
font-feature = cv02
font-feature = zero

cursor-style = bar
cursor-style-blink = true
background-opacity = 0.80
background-blur = true
# themes/ayu-custom, matches kitty/fish/starship/nvim
theme = ayu-custom

window-width = 120
window-height = 36
window-padding-x = 14
window-padding-y = 8
window-save-state = always
# kitty: inactive_text_alpha
unfocused-split-opacity = 0.75

shell-integration = detect
clipboard-paste-protection = true
copy-on-select = clipboard
confirm-close-surface = false
mouse-hide-while-typing = true
